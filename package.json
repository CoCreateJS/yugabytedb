{
  "name": "@cocreate/yugabytedb",
  "version": "2.0.0",
  "description": "Lightweight, real-time YugabyteDB CRUD wrapper and multi-tenant state routing client for the collaborative CoCreate ecosystem.",
  "keywords": [
    "yugabytedb",
    "postgresql",
    "sql",
    "jsonb",
    "crud-api",
    "abstract-crud",
    "database-abstraction",
    "multi-tenant",
    "multi-tenant-routing",
    "realtime-sync",
    "state-synchronization",
    "shared-editing",
    "collaborative-editing",
    "websocket-mesh",
    "peer-to-peer-sync",
    "p2p-database"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/yugabytedb.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/yugabytedb/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/yugabytedb",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreateJS"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dist": "./dist/yugabytedb.js"
  },
  "devDependencies": {
    "@cocreate/webpack": "^2.0.0"
  },
  "dependencies": {
    "@cocreate/postgresql": "^2.0.0",
    "@cocreate/utils": "^2.0.0"
  }
}